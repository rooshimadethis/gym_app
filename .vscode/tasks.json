{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Flutter Run (HiBreak)",
            "type": "shell",
            "command": "flutter run -d B651DNW2FLKB006000379",
            "problemMatcher": [
                "$dart-sdk"
            ],
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        },
        {
            "label": "Launch iOS Simulator",
            "type": "shell",
            "command": "open -a Simulator || flutter emulators --launch apple_ios_simulator",
            "presentation": {
                "reveal": "silent"
            }
        },
        {
            "label": "Launch Pixel 9",
            "type": "shell",
            "command": "pgrep -f \" -avd Pixel_9 \" > /dev/null || (flutter emulators --launch Pixel_9 > /dev/null 2>&1 &)",
            "presentation": {
                "reveal": "silent"
            }
        },
        {
            "label": "Launch Pixel 9 Pro Fold (2)",
            "type": "shell",
            "command": "pgrep -f \" -avd Pixel_9_Pro_Fold_2 \" > /dev/null || (flutter emulators --launch Pixel_9_Pro_Fold_2 > /dev/null 2>&1 &)",
            "presentation": {
                "reveal": "silent"
            }
        }
    ]
}